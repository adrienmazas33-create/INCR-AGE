; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="INCR-AGE (prototype)"
config/description="Prototype phase 1 : carte fixe, héros, caméra."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameSettings="*res://scripts/autoload/game_settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
CombatFx="*res://scripts/autoload/combat_fx.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":90), Object(InputEventKey,"keycode":87), Object(InputEventKey,"keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":83), Object(InputEventKey,"keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":81), Object(InputEventKey,"keycode":65), Object(InputEventKey,"keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":68), Object(InputEventKey,"keycode":4194321)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4,"pressed":true)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5,"pressed":true)]
}
toggle_fullscreen={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194342)]
}
buy_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49), Object(InputEventKey,"keycode":4194439)]
}
buy_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50), Object(InputEventKey,"keycode":4194440)]
}
buy_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51), Object(InputEventKey,"keycode":4194441)]
}
buy_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52), Object(InputEventKey,"keycode":4194442)]
}
quit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194305)]
}

[layer_names]

2d_physics/layer_1="monde"
2d_physics/layer_2="personnages"
2d_physics/layer_3="ennemis"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.141, 0.227, 0.153, 1)
